###VTEP
#Create and bring up bridge interface
ip link add br0 type bridge
ip link set dev br0 up

#Create VTEP interface(id = 10, default multicast group)
ip link add vxlan10 type vxlan id 10 dstport 4789
ip link set dev vxlan10 up

#Add vxlan10/eth1 as a port to br0
brctl addif br0 vxlan10
brctl addif br0 eth1


###EPVN config

vtysh
conf t

#Config interface connected to RR
interface eth0
ip address 10.1.1.2/30
#OSPF area 0 so it can isolate routers from external changes
ip ospf area 0
#Config lo interface for BGP discovery
interface lo
ip address 1.1.1.2/32
ip ospf area 0

#Start BGP and declare that this router belongs to AS 1
router bgp 1

#Mentioning route reflector in the AS number 1
neighbor 1.1.1.1 remote-as 1

#Force BGP sessions to use loopback interface as the source IP
neighbor 1.1.1.1 update-source lo

#Activate EVPN address familly
address-family l2vpn evpn

#Activate RR neighbour
neighbor 1.1.1.1 activate

#Every router should advertise their VNI, so the neighbours can update their routing table
advertise-all-vni
exit-address-family

#Enabling OSPF for this router
router ospf
